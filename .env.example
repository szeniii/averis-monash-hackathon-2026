# Copy this file to .env and put your real key in it.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# .env is gitignored. .env.example is not, and must never contain a real key.
#
# Get a key at https://aistudio.google.com/app/apikey -> "Get API key".
GEMINI_API_KEY=your-key-here

# Optional. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-pro
